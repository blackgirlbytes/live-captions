# Optional server-side Deepgram API key (Member role or higher). Never exposed to the browser:
# the app mints 60-second tokens via POST /api/deepgram/token.
# Leave it unset to deploy publicly without paying for visitors' usage: each visitor is then
# asked for their own Deepgram key, which stays in their browser and goes only to Deepgram.
# Visitors can also choose their own key in settings even when this is set.
# Create one at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional: comma-separated Chrome extension IDs allowed to call the token endpoint.
# When unset, any chrome-extension:// origin is allowed (handy for unpacked dev builds).
EARSHOT_EXTENSION_IDS=

# Optional: max token requests per IP per minute (default 30).
EARSHOT_TOKEN_RATE_LIMIT=
